# ─── Environment Variables Required ────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ─── Neon PostgreSQL (set automatically by Vercel Neon integration) ─────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST_UNPOOLED/DATABASE?sslmode=require
POSTGRES_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
POSTGRES_URL_NON_POOLING=postgresql://USER:PASSWORD@HOST_UNPOOLED/DATABASE?sslmode=require

# ─── Session Security ────────────────────────────────────────────────────────
# Must be a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret

# ─── Vercel Blob Storage (optional — required for image uploads on Vercel) ──
# Create a Blob store in your Vercel project → Storage → Blob
# BLOB_READ_WRITE_TOKEN is provided automatically if configured in Vercel.
BLOB_READ_WRITE_TOKEN=

# ─── Local Development Only ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
